{
    "task": [
        {
            "name": "心链送礼",
            "entry": "心链_入口",
            "description": "自动打开心链页面，并且为心链顶置旅人赠送礼物"
        },
        {
            "name": "心鏈送禮(新)",
            "entry": "心链_入口",
            "description": "自动打开心链页面，并且为心链顶置旅人赠送指定类型的礼物",
            "option": [
                "心链送礼新_旅人",
                "心链送礼新_礼物类型"
            ]
        }
    ],
    "option": {
        "心链送礼新_旅人": {
            "type": "input",
            "inputs": [
                {
                    "name": "旅人名稱",
                    "pipeline_type": "string",
                    "default": "",
                    "description": "填入要赠送礼物的旅人名称；留空或输入 x 时不切换旅人。"
                }
            ],
            "pipeline_override": {
                "心链送礼新_选择旅人": {
                    "attach": {
                        "trekker": "{旅人名稱}"
                    }
                }
            }
        },
        "心链送礼新_礼物类型": {
            "type": "select",
            "label": "贈送的禮物",
            "description": "可维持原本的最高匹配分数选择，或向下滚动后只选择蓝色底且带黄色笑脸的礼物。",
            "default_case": "匹配分數最高的禮物",
            "cases": [
                {
                    "name": "匹配分數最高的禮物",
                    "pipeline_override": {
                        "心链_点击邮寄": {
                            "next": [
                                "心链送礼新_选择旅人"
                            ]
                        },
                        "心链送礼新_选择旅人": {
                            "next": [
                                "心链_选择礼物"
                            ]
                        }
                    }
                },
                {
                    "name": "只送藍色禮物",
                    "pipeline_override": {
                        "心链_点击邮寄": {
                            "next": [
                                "心链送礼新_选择旅人"
                            ]
                        },
                        "心链送礼新_选择旅人": {
                            "next": [
                                "心链送礼新_选择十个蓝色礼物"
                            ]
                        }
                    }
                }
            ]
        }
    }
}
