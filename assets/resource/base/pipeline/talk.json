      "param": {
        "expected": [
          "HeartlinkGiftCount"
        ],
        "roi": [
          1000,
          640,
          240,
          60
        ]
      },
      "type": "OCR"
    }
  },
  "心链送礼新_识别蓝色礼物": {
    "recognition": {
      "param": {
        "order_by": "Score",
        "roi": [
          600,
          230,
          500,
          400
        ],
        "template": [
          "gift_blue_good.png"
        ],
        "threshold": 0.65
      },
      "type": "TemplateMatch"
    }
  },
  "心链送礼新_向下滚动一步": {
    "action": {
      "param": {
        "begin": [
          850,
          480
        ],
        "duration": 800,
