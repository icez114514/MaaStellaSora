{
  "心链_入口": {
    "action": {
      "param": {},
      "type": "DoNothing"
    },
    "next": [
      "心链_判断是否在主页",
      {
        "jump_back": true,
        "name": "通用_返回主页"
      }
    ],
    "post_delay": 0,
    "pre_delay": 0,
    "recognition": {
      "param": {},
      "type": "DirectHit"
    }
  },
  "心链_判断是否在主页": {
    "action": {
      "param": {},
      "type": "DoNothing"
    },
    "recognition": {
      "param": {
        "template": [
          "menu.png"
        ]
      },
      "type": "TemplateMatch"
    },
    "next": [
      "心链_打开心链"
    ]
  },
  "心链_打开心链": {
    "action": {
      "param": {},
      "type": "Click"
    },
    "focus": {
      "Node.Action.Starting": "正在打开心链"
    },
    "next": [
      "心链_点击邮寄"
    ],
    "post_wait_freezes": 2000,
    "recognition": {
      "param": {
        "template": [
          "Invite/heartlink.png"
        ]
      },
      "type": "TemplateMatch"
    }
  },
  "心链_点击邮寄": {
    "action": {
      "param": {},
      "type": "Click"
    },
    "focus": {
      "Node.Action.Starting": "正在点击邮寄按钮"
    },
    "next": [
      "心链_选择礼物"
    ],
    "recognition": {
      "param": {
        "expected": [
          "邮寄"
        ]
      },
      "type": "OCR"
    }
  },
  "心链_赠送礼物": {
    "action": {
      "param": {},
      "type": "Click"
    },
    "focus": {
      "Node.Action.Starting": "正在赠送礼物"
    },
    "next": [
      "心链_默契提升",
      "通用_返回主页"
    ],
    "recognition": {
      "param": {
        "expected": [
          "赠送礼物"
        ]
      },
      "type": "OCR"
    },
    "timeout": 5000
  },
  "心链_选择礼物": {
    "action": {
      "param": {},
      "type": "Click"
    },
    "focus": {
      "Node.Recognition.Failed": "没有找到礼物图标 可能是没有礼物 跳过",
      "Node.Recognition.Starting": "正在选择礼物"
    },
    "next": [
      "心链_赠送礼物"
    ],
    "recognition": {
      "param": {
        "template": [
          "gift_good.png"
        ]
      },
      "type": "TemplateMatch"
    },
    "timeout": 3000
  },
  "心链_默契提升": {
    "action": {
      "param": {},
      "type": "Click"
    },
    "focus": {
      "Node.Action.Starting": "正在关闭弹窗"
    },
    "next": [
      "通用_返回主页"
    ],
    "pre_wait_freezes": 1000,
    "recognition": {
      "param": {
        "expected": [
          "默契提升"
        ]
      },
      "type": "OCR"
    }
  },
  "心链送礼新_选择旅人": {
    "action": {
      "param": {
        "custom_action": "HeartlinkGiftSelectTrekker"
      },
      "type": "Custom"
    },
    "attach": {
      "trekker": ""
    },
    "focus": {
      "Node.Action.Starting": "正在选择送礼旅人"
    },
    "next": [
      "心链_选择礼物"
    ],
    "post_wait_freezes": 500
  },
  "心链送礼新_选择十个蓝色礼物": {
    "action": {
      "param": {
        "custom_action": "HeartlinkGiftSelectBlue"
      },
      "type": "Custom"
    },
    "focus": {
      "Node.Action.Starting": "正在选择10个蓝色礼物"
    },
    "next": [
      "心链_赠送礼物"
    ],
    "post_wait_freezes": 500
  },
  "心链送礼新_识别已选礼物数量": {
