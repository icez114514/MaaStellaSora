          230
        ],
        "end_hold": 500
      },
      "type": "Swipe"
    },
    "recognition": {
      "param": {},
      "type": "DirectHit"
    }
  },
  "心链送礼新_向下滚动": {
    "action": {
      "param": {
        "begin": [
          850,
          480
        ],
        "end": [
          850,
          230
        ],
        "duration": 800,
        "end_hold": 500
      },
      "type": "Swipe"
    },
    "focus": {
      "Node.Action.Starting": "正在向下滚动礼物列表"
    },
    "next": [
      "心链送礼新_选择蓝色礼物"
    ],
    "post_wait_freezes": 500,
    "recognition": {
      "param": {},
      "type": "DirectHit"
    }
  },
  "心链送礼新_选择蓝色礼物": {
    "action": {
      "param": {},
      "type": "Click"
    },
    "focus": {
      "Node.Recognition.Failed": "没有找到蓝色礼物 跳过",
      "Node.Recognition.Starting": "正在选择蓝色礼物"
